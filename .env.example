# OpenCoreEMR Sinch Conversations Module - Environment Configuration
#
# Set OCE_SINCH_CONVERSATIONS_ENV_CONFIG=1 to read configuration from
# environment variables instead of the OpenEMR database.
#
# This is useful for:
# - Docker deployments where config is injected via environment
# - CI/CD pipelines
# - Development environments
# - Kubernetes/container orchestration

# Enable environment-based configuration (required to use other env vars)
OCE_SINCH_CONVERSATIONS_ENV_CONFIG=1

# Enable the module
OCE_SINCH_CONVERSATIONS_ENABLED=1

# Sinch API Credentials (from dashboard.sinch.com)
OCE_SINCH_CONVERSATIONS_PROJECT_ID=your-project-id
OCE_SINCH_CONVERSATIONS_APP_ID=your-app-id
OCE_SINCH_CONVERSATIONS_API_KEY=your-api-key
OCE_SINCH_CONVERSATIONS_API_SECRET=your-api-secret

# API Region: us or eu
OCE_SINCH_CONVERSATIONS_REGION=us

# Default messaging channel: SMS, WHATSAPP, etc.
OCE_SINCH_CONVERSATIONS_DEFAULT_CHANNEL=SMS

# Clinic information (used in message templates)
OCE_SINCH_CONVERSATIONS_CLINIC_NAME=Your Clinic Name
OCE_SINCH_CONVERSATIONS_CLINIC_PHONE=+1234567890

# Webhook HMAC-SHA256 shared secret (from Sinch dashboard webhook configuration)
OCE_SINCH_CONVERSATIONS_WEBHOOK_SECRET=your-webhook-secret

# Webhook IP allowlist (comma-separated IPs or CIDR ranges, empty = allow all)
# OCE_SINCH_CONVERSATIONS_WEBHOOK_IP_ALLOWLIST=
